# Copy this file to .env and fill in real values. NEVER commit .env.

# Database (SQLite — file created automatically at server/data/app.sqlite)
# DATABASE_URL is optional; SQLite path is server/data/app.sqlite

# JWT — generate strong random secrets (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=lkr
AD_POSTING_FEE_CENTS=99900

# Server
PORT=3001
NODE_ENV=development

# Legacy/unused (kept for backwards compatibility)
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/dbname

# Email Configuration - Gmail
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=replace-me
