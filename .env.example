# Local dev
SESSION_SECRET=change-me
PORT=3001

# ── JWT Secrets ────────────────────────────────────────────────────────────
JWT_SECRET=local-dev-access-secret-change-me-in-production
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me-in-production
JWT_EMAIL_VERIFICATION_SECRET=local-dev-email-verification-secret-change-me-in-production

# ── Email Configuration ────────────────────────────────────────────────────
# Gmail Configuration:
# 1. Enable 2FA on your Google account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Set GMAIL_USER to your Gmail address
# 4. Set GMAIL_APP_PASSWORD to the 16-character app password generated

GMAIL_USER=theceylonsuperhub@gmail.com
GMAIL_APP_PASSWORD=akdy jsxy bfnv ejak

# Alternative: Use custom SMTP provider
# Uncomment the following lines if using a custom SMTP provider
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-email-password
# EMAIL_FROM_ADDRESS=noreply@example.com

# ── Email Verification Settings ────────────────────────────────────────────
# OTP expiration time in minutes
OTP_EXPIRATION_MINUTES=15

# ── Domain Allowlist ───────────────────────────────────────────────────────
# Comma-separated list of allowed email domains (empty = all domains allowed)
ALLOWED_EMAIL_DOMAINS=

# ── Node Environment ───────────────────────────────────────────────────────
NODE_ENV=development

# ── Stripe Configuration (Optional) ────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=lkr
AD_POSTING_FEE_CENTS=99900

# ── Cloudinary Configuration (Optional) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
